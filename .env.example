# TOSNOSAI ENVIRONMENT CONFIGURATION

# Primary AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Configured Models
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Primary Voice & Emotion Services
STT_PROVIDER=web-speech
TTS_PROVIDER=web-speech
EMOTION_SERVICE_URL=http://localhost:8000

# Database Connection (PostgreSQL or SQLite dual mode)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tosnosai?schema=public"

# Auth & Session Security
AUTH_SECRET=tosnosai_super_secret_jwt_key_2026_change_in_production
NODE_ENV=development
